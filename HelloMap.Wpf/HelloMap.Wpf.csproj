<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>..\HelloMap.Winforms\resources\geokernel.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <PackageReference Include="GeoKernel.NET" Version="1.1.28" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\HelloMap.Winforms\resources\ZoomIn.png" Link="Images\ZoomIn.png" />
    <Resource Include="..\HelloMap.Winforms\resources\ZoomOut.png" Link="Images\ZoomOut.png" />
    <Resource Include="..\HelloMap.Winforms\resources\FullExtent.png" Link="Images\FullExtent.png" />
    <Resource Include="..\HelloMap.Winforms\resources\RectangularZoom.png" Link="Images\RectangularZoom.png" />
    <Resource Include="..\HelloMap.Winforms\resources\Pan.png" Link="Images\Pan.png" />
    <Resource Include="..\HelloMap.Winforms\resources\geokernel.ico" Link="Images\GeoKernelAppIcon.ico" />
  </ItemGroup>
</Project>
