<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>..\..\GeoKernel.Examples.NET2\images\GeoKernelAppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <PackageReference Include="GeoKernel.NET" Version="1.1.28" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\GeoKernel.Examples.NET2\images\FullExtent.png" Link="Images\FullExtent.png" />
    <Resource Include="..\..\GeoKernel.Examples.NET2\images\GeoKernelAppIcon.ico" Link="Images\GeoKernelAppIcon.ico" />
  </ItemGroup>
</Project>

