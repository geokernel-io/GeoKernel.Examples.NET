<Window x:Class="GeoKernel.MifLoad.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="MifLoad" Width="1200" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Icon="Images/GeoKernelAppIcon.ico" Loaded="Window_Loaded">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom"><TextBlock x:Name="statusText" Text="Preparing MapInfo MIF sample data..." /></StatusBar>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="440" /></Grid.ColumnDefinitions>
            <gk:GeoKernelViewerControl x:Name="viewerControl" Grid.Column="0" />
            <Grid Grid.Column="1" Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" /><RowDefinition Height="190" />
                    <RowDefinition Height="22" /><RowDefinition Height="*" />
                    <RowDefinition Height="22" /><RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Layer metadata" />
                <TextBox x:Name="detailsTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" />
                <TextBlock Grid.Row="2" Text="Attribute schema" />
                <DataGrid x:Name="schemaGrid" Grid.Row="3" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Field" Binding="{Binding Name}" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" />
                        <DataGridTextColumn Header="Length" Binding="{Binding Length}" />
                        <DataGridTextColumn Header="Decimals" Binding="{Binding DecimalCount}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="4" Text="First 12 attribute rows" />
                <DataGrid x:Name="attributesGrid" Grid.Row="5" IsReadOnly="True" AutoGenerateColumns="True" HeadersVisibility="Column" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
