<Window x:Class="GeoKernel.BusyCallback.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="BusyCallback"
        Width="1100"
        Height="680"
        MinWidth="820"
        MinHeight="520"
        Icon="/Images/GeoKernelAppIcon.ico"     
        Loaded="Window_Loaded">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button x:Name="loadButton"
                    Content="Load Large Layer"
                    Click="Load_Click" />
            <Button x:Name="clearButton"
                    Content="Clear"
                    Click="Clear_Click" />
            <Separator />
            <TextBlock x:Name="busyStateText"
                       Text="Busy: OFF"
                       VerticalAlignment="Center"
                       Margin="6,0" />
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="statusText" />
            <ProgressBar x:Name="progressBar"
                         Width="140"
                         Height="16"
                         Minimum="0"
                         Maximum="100" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <gk:GeoKernelViewerControl x:Name="viewerControl"
                                       Grid.Column="0" />

            <TextBox x:Name="eventLogTextBox"
                     Grid.Column="1"
                     FontFamily="Consolas"
                     FontSize="12"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>
    </DockPanel>
</Window>
