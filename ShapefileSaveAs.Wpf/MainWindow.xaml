<Window x:Class="GeoKernel.ShapefileSaveAs.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="ShapefileSaveAs" Width="1200" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Icon="Images/GeoKernelAppIcon.ico" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="6,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="saveButton" MinWidth="140" Margin="0,0,8,0" Content="Save As Shapefile" Click="Save_Click"/>
            <ProgressBar x:Name="saveProgressBar" Grid.Column="1" Minimum="0" Maximum="100"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="440"/></Grid.ColumnDefinitions>
            <gk:GeoKernelViewerControl x:Name="viewerControl"/>
            <Grid Grid.Column="1" Margin="6">
                <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="SaveAs state" VerticalAlignment="Center"/>
                <TextBox x:Name="detailsTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                <TextBlock Grid.Row="2" Text="Reloaded output attributes" VerticalAlignment="Bottom"/>
                <DataGrid x:Name="attributesGrid" Grid.Row="3" AutoGenerateColumns="True" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="FullRow"/>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#F4F4F4" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="statusText" Margin="4,0" VerticalAlignment="Center" Text="Preparing shapefile sample..."/>
        </Border>
    </Grid>
</Window>
