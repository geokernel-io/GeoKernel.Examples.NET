<Window x:Class="GeoKernel.BasicLabel.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="BasicLabel"
        Width="1200"
        Height="800"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#EFEFEF" Padding="8">
                <StackPanel>
                    <TextBlock Text="Label style" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <CheckBox x:Name="showLabelsCheckBox"
                              Content="Show labels"
                              IsChecked="True"
                              Margin="0,0,0,14"
                              Checked="LabelControl_Changed"
                              Unchecked="LabelControl_Changed" />

                    <TextBlock Text="Label field" Margin="0,0,0,6" />
                    <ComboBox x:Name="fieldComboBox"
                              Height="24"
                              Margin="0,0,0,12"
                              SelectionChanged="LabelControl_Changed" />

                    <TextBlock Text="Font size" Margin="0,0,0,6" />
                    <TextBox x:Name="fontSizeTextBox"
                             Height="24"
                             Text="9.0"
                             VerticalContentAlignment="Center"
                             TextChanged="LabelControl_Changed" />
                </StackPanel>
            </Border>

            <gk:GeoKernelViewerControl x:Name="viewerControl" Grid.Column="1" />
        </Grid>

        <Border Grid.Row="1" Background="#F4F4F4" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="statusText" VerticalAlignment="Center" Margin="4,0" Text="Ready" />
        </Border>
    </Grid>
</Window>
