<Window x:Class="GeoKernel.TopologyFix.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="TopologyFix"
        Width="1040"
        Height="680"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Full Extent" Click="FullExtent_Click" />
            <Separator />
            <TextBlock Text="Operation:" VerticalAlignment="Center" Margin="4,0" />
            <ComboBox x:Name="operationComboBox"
                      Width="230"
                      SelectionChanged="OperationComboBox_SelectionChanged">
                <ComboBoxItem Content="Source only" IsSelected="True" />
                <ComboBoxItem Content="FixShape" />
                <ComboBoxItem Content="FixShapeEx" />
                <ComboBoxItem Content="ClearShape" />
            </ComboBox>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="statusText" Text="Source geometry is shown. Choose a fix operation." />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <gk:GeoKernelViewerControl x:Name="viewerControl" Grid.Column="0" />
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
            <TextBox x:Name="detailsTextBox"
                     Grid.Column="2"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="12" />
        </Grid>
    </DockPanel>
</Window>
