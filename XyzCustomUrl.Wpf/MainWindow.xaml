<Window x:Class="GeoKernel.XyzCustomUrl.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="XyzCustomUrl" Width="1280" Height="800" MinWidth="920" MinHeight="520"
        WindowStartupLocation="CenterScreen" Icon="Images/GeoKernelAppIcon.ico" Loaded="Window_Loaded">
    <DockPanel Background="#F4F6F5">
        <Border DockPanel.Dock="Top" Height="40" Background="#F1F1F1">
            <DockPanel Margin="4,3">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Width="58" Margin="0,0,3,0" Click="ZoomIn_Click">Zoom In</Button>
                    <Button Width="66" Margin="0,0,3,0" Click="ZoomOut_Click">Zoom Out</Button>
                    <Button Width="74" Margin="0,0,3,0" Click="FullExtent_Click">Full Extent</Button>
                    <Button Width="72" Margin="0,0,3,0" Click="ZoomRect_Click">Zoom Rect</Button>
                    <Button Width="44" Margin="0,0,8,0" Click="Pan_Click">Pan</Button>
                    <TextBlock Text="URL:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="urlTextBox" Width="390" VerticalContentAlignment="Center" KeyDown="UrlTextBox_KeyDown" />
                    <TextBlock Text="Min:" VerticalAlignment="Center" Margin="8,0,3,0" />
                    <TextBox x:Name="minZoomTextBox" Width="34" VerticalContentAlignment="Center" />
                    <TextBlock Text="Max:" VerticalAlignment="Center" Margin="8,0,3,0" />
                    <TextBox x:Name="maxZoomTextBox" Width="34" VerticalContentAlignment="Center" />
                    <CheckBox x:Name="localCacheCheckBox" Content="Local cache" VerticalAlignment="Center" Margin="10,0" />
                    <Button Width="72" Click="ApplyUrl_Click">Apply URL</Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom" Height="22"><TextBlock x:Name="statusText" Text="XyzCustomUrl ready." /></StatusBar>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="380" /></Grid.ColumnDefinitions>
            <gk:GeoKernelViewerControl x:Name="viewerControl" Grid.Column="0" />
            <TextBox x:Name="detailsTextBox" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
        </Grid>
    </DockPanel>
</Window>
