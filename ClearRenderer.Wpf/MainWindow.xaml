<Window x:Class="GeoKernel.ClearRenderer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="ClearRenderer"
        Width="1200"
        Height="800"
        MinWidth="760"
        MinHeight="520"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F2F2F2"
                BorderBrush="#C8C8C8"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Margin="4,0,0,0"
                        Padding="10,3"
                        Content="Apply Categorized Renderer"
                        Click="ApplyRendererButton_Click" />
                <Button Margin="8,0,0,0"
                        Padding="10,3"
                        Content="Clear Renderer"
                        Click="ClearRendererButton_Click" />
                <TextBlock x:Name="rendererStateText"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Renderer: categorized by STATE" />
            </StackPanel>
        </Border>

        <gk:GeoKernelViewerControl x:Name="viewerControl"
                                   Grid.Row="1" />

        <Border Grid.Row="2"
                Background="#F4F4F4"
                BorderBrush="#D0D0D0"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="statusText"
                       VerticalAlignment="Center"
                       Margin="4,0"
                       Text="Ready" />
        </Border>
    </Grid>
</Window>
