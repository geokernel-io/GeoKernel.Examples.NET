<Window x:Class="GeoKernel.ToolSelect_Mode.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="ToolSelect_Mode" Width="1200" Height="800" MinWidth="950" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="Images/GeoKernelAppIcon.ico" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/></Style>
        <Style x:Key="ToolToggle" TargetType="ToggleButton"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#D2E8F7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#0078D7"/></Trigger></Style.Triggers></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#F2F2F2">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="selectButton" Style="{StaticResource ToolToggle}" IsChecked="True" Click="Select_Click" ToolTip="Box Select"><Image Source="Images/Select.png" Stretch="Uniform"/></ToggleButton>
                <ToggleButton x:Name="panButton" Style="{StaticResource ToolToggle}" Click="Pan_Click" ToolTip="Pan"><Image Source="Images/Pan.png" Stretch="Uniform"/></ToggleButton>
                <Button Style="{StaticResource ToolButton}" Click="ClearSelection_Click" ToolTip="Clear Selection"><Image Source="Images/Delete.png" Stretch="Uniform"/></Button>
                <Button Style="{StaticResource ToolButton}" Click="FullExtent_Click" ToolTip="Full Extent"><Image Source="Images/FullExtent.png" Stretch="Uniform"/></Button>
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="API: hitTestFeaturesInScreenRect(screenRect)"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="356"/></Grid.ColumnDefinitions>
            <gk:GeoKernelViewerControl x:Name="viewerControl"/>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="270"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DataGrid x:Name="hitsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionChanged="HitsGrid_SelectionChanged" SelectionMode="Single" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="38"/>
                        <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="*"/>
                        <DataGridTextColumn Header="Shape" Binding="{Binding ShapeId}" Width="58"/>
                        <DataGridTextColumn Header="Feature" Binding="{Binding FeatureId}" Width="62"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding ShapeType}" Width="72"/>
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="attributesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow">
                    <DataGrid.Columns><DataGridTextColumn Header="Property / Field" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/></DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#F4F4F4" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0"><TextBlock x:Name="statusText" Margin="4,0" VerticalAlignment="Center" Text="Ready"/></Border>
    </Grid>
</Window>
