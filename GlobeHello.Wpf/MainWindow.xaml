<Window x:Class="GeoKernel.GlobeHello.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="GeoKernel — Globe Hello" Width="1100" Height="760"
        MinWidth="640" MinHeight="480" WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>
        <ToolBar x:Name="Toolbar" IsEnabled="False" ToolBarTray.IsLocked="True">
            <ToggleButton x:Name="Atmosphere" Content="Atmosphere" Click="ApplyOptions" />
            <ToggleButton x:Name="Esri" Content="Esri Satellite" Click="ApplyOptions"
                          ToolTip="Esri World Imagery; internet required" />
            <ToggleButton x:Name="Dem" Content="DEM" Click="ApplyOptions"
                          ToolTip="Esri Terrain3D elevation, 1x; internet required" />
            <ToggleButton x:Name="Sunlight" Content="Sunlight" Click="ApplyOptions" />
        </ToolBar>
        <gk:GeoKernelGlobeControl x:Name="GlobeView" Grid.Row="1" GlobeReady="GlobeReady" />
        <Border Grid.Row="2" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <TextBlock x:Name="Status" Text="Preparing globe…" Margin="6,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Border>
    </Grid>
</Window>
