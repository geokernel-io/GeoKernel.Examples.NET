<Window x:Class="GeoKernel.AddShapeToEditLayer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="AddShapeToEditLayer" Width="1200" Height="800"
        MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico" Background="#F4F6F5" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#F1F1F1" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="39" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#F1F1F1">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButtonStyle}" Content="Add Shape" Click="AddShape_Click" />
                <Button Style="{StaticResource ToolbarButtonStyle}" Content="Clear Polygons" Click="ClearPolygons_Click" />
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="FullExtent_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="24" Height="24" Source="Images/FullExtent.png" Stretch="Uniform" />
                        <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="Full Extent" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="polygonCountText" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" Text="Polygon count: 0" />
            </StackPanel>
        </Border>
        <gk:GeoKernelViewerControl x:Name="viewerControl" Grid.Row="1" />
        <StatusBar Grid.Row="2"><TextBlock x:Name="statusText" Text="Ready." /></StatusBar>
    </Grid>
</Window>
