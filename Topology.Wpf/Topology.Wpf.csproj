<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable><UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget><Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>..\Images\GeoKernelAppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="GeoKernel.NET"/></ItemGroup>
  <ItemGroup>
    <Resource Include="..\Images\GeoKernelAppIcon.ico" Link="Images\GeoKernelAppIcon.ico"/>
    <Resource Include="..\Images\Pan.png" Link="Images\Pan.png"/>
    <Resource Include="..\Images\RectangularZoom.png" Link="Images\RectangularZoom.png"/>
    <Resource Include="..\Images\FullExtent.png" Link="Images\FullExtent.png"/>
  </ItemGroup>
</Project>
