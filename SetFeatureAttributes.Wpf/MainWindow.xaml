<Window x:Class="GeoKernel.SetFeatureAttributes.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="SetFeatureAttributes" Width="1120" Height="760" MinWidth="820" MinHeight="560"
        Icon="Images/GeoKernelAppIcon.ico" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <ToolBarTray Grid.Row="0"><ToolBar>
            <Button Content="Apply Attributes" Click="Apply_Click"/>
            <Button x:Name="undoButton" Content="Undo" Click="Undo_Click"/>
            <Button x:Name="redoButton" Content="Redo" Click="Redo_Click"/>
            <Button Content="Reset" Click="Reset_Click"/><Button Content="Full Extent" Click="FullExtent_Click"/>
            <TextBlock x:Name="stateText" Margin="12,0" VerticalAlignment="Center" Text="Editing: OFF | Selected: -"/>
        </ToolBar></ToolBarTray>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="335"/></Grid.ColumnDefinitions>
            <gk:GeoKernelViewerControl x:Name="viewerControl"/>
            <Border Grid.Column="1" Background="#F2F2F2" BorderBrush="#D0D0D0" BorderThickness="1,0,0,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="154"/><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <GroupBox Header="Selected feature attributes" Padding="8"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                        <TextBlock Text="Name" VerticalAlignment="Center"/><TextBox x:Name="nameTextBox" Grid.Column="1" Height="23"/>
                        <TextBlock Grid.Row="1" Text="Status" VerticalAlignment="Center"/><ComboBox x:Name="statusComboBox" Grid.Row="1" Grid.Column="1" Height="24"/>
                        <TextBlock Grid.Row="2" Text="Priority" VerticalAlignment="Center"/>
                        <TextBox x:Name="priorityTextBox" Grid.Row="2" Grid.Column="1" Height="23"/>
                    </Grid></GroupBox>
                    <TextBlock Grid.Row="1" Text="Editable points" VerticalAlignment="Center"/>
                    <DataGrid x:Name="featureGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionChanged="FeatureGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding ShapeId}" Width="42"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="78"/><DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="64"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#F4F4F4" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="statusText" Margin="4,0" VerticalAlignment="Center" Text="Ready"/>
        </Border>
    </Grid>
</Window>
