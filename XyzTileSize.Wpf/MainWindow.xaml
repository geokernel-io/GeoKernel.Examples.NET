<Window x:Class="GeoKernel.XyzTileSize.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="XyzTileSize" Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="Images/GeoKernelAppIcon.ico" Loaded="Window_Loaded">
    <DockPanel Background="#F4F6F5">
        <ToolBar DockPanel.Dock="Top" Height="40" Band="0" BandIndex="0">
            <Button ToolTip="Zoom In" Click="ZoomIn_Click"><Image Source="Images/ZoomIn.png" Width="28" Height="28" /></Button>
            <Button ToolTip="Zoom Out" Click="ZoomOut_Click"><Image Source="Images/ZoomOut.png" Width="28" Height="28" /></Button>
            <Button ToolTip="Full Extent" Click="FullExtent_Click"><Image Source="Images/FullExtent.png" Width="28" Height="28" /></Button>
            <Separator />
            <Button ToolTip="Zoom Rectangle" Click="ZoomRect_Click"><Image Source="Images/RectangularZoom.png" Width="28" Height="28" /></Button>
            <Button ToolTip="Pan" Click="Pan_Click"><Image Source="Images/Pan.png" Width="28" Height="28" /></Button>
        </ToolBar>
        <StatusBar DockPanel.Dock="Bottom" Height="22"><TextBlock x:Name="statusText" Text="XyzTileSize ready." /></StatusBar>
        <Grid>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions><RowDefinition Height="27" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Background="#EEEEEE"><TextBlock Text="256 px tiles | tileSize: 256" FontWeight="SemiBold" Margin="6,5" /></Border>
                    <gk:GeoKernelViewerControl x:Name="leftViewerControl" Grid.Row="1" />
                </Grid>
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="27" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Background="#EEEEEE"><TextBlock Text="512 px tiles | tileSize: 512" FontWeight="SemiBold" Margin="6,5" /></Border>
                    <gk:GeoKernelViewerControl x:Name="rightViewerControl" Grid.Row="1" />
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
