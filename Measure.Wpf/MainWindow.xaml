<Window x:Class="GeoKernel.Measure.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="Measure" Width="1200" Height="800" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" Icon="Images/GeoKernelAppIcon.ico" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/>
            <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#C8E6FF"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" Height="24"><TextBlock x:Name="statusText" Text="Ready"/></StatusBar>
        <Border DockPanel.Dock="Top" Height="39" Background="#F1F1F1">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="panButton" Style="{StaticResource ToolToggle}" ToolTip="Pan" Click="Pan_Click"><Image Source="Images/Pan.png"/></ToggleButton>
                <ToggleButton x:Name="distanceButton" Style="{StaticResource ToolToggle}" ToolTip="Measure distance" Click="Distance_Click"><Image Source="Images/MeasureDistance.png"/></ToggleButton>
                <ToggleButton x:Name="areaButton" Style="{StaticResource ToolToggle}" ToolTip="Measure area" Click="Area_Click"><Image Source="Images/MeasureArea.png"/></ToggleButton>
                <Border Width="1" Height="28" Margin="4" Background="#999999"/>
                <Button Style="{StaticResource ToolButton}" ToolTip="Clear measurements" Click="Clear_Click"><Image Source="Images/Delete.png"/></Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="Full extent" Click="FullExtent_Click"><Image Source="Images/FullExtent.png"/></Button>
            </StackPanel>
        </Border>
        <gk:GeoKernelViewerControl x:Name="viewerControl"/>
    </DockPanel>
</Window>
