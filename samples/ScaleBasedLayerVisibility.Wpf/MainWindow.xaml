<Window x:Class="GeoKernel.ScaleBasedLayerVisibility.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="ScaleBasedLayerVisibility"
        Width="1200"
        Height="800"
        MinWidth="720"
        MinHeight="480"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#EFEFEF"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="scaleText"
                               Grid.Row="0"
                               VerticalAlignment="Center"
                               Text="Current scale: -" />

                    <TextBlock Grid.Row="1"
                               VerticalAlignment="Center"
                               Text="Visible scale ranges: [min - max]" />

                    <ListBox x:Name="layerListBox"
                             Grid.Row="2"
                             Margin="0,8,0,0"
                             FontFamily="Consolas"
                             FontSize="12" />
                </Grid>
            </Border>

            <gk:GeoKernelViewerControl x:Name="viewerControl"
                                       Grid.Column="1"
                                       MapBackgroundColor="#F4F6F5" />
        </Grid>

        <Border Grid.Row="1"
                Background="#F4F4F4"
                BorderBrush="#D0D0D0"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="statusText"
                       VerticalAlignment="Center"
                       Margin="4,0"
                       Text="Zoom in/out: World, States and Cities appear at different scale ranges." />
        </Border>
    </Grid>
</Window>
