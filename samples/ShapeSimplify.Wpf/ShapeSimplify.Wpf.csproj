<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GeoKernelSkipNativeRuntimeBuild>true</GeoKernelSkipNativeRuntimeBuild>
    <GeoKernelSdkConfiguration Condition="'$(GeoKernelSdkConfiguration)' == ''">Release</GeoKernelSdkConfiguration>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="GeoKernel.NET.Wpf.Controls">
      <HintPath>$(GeoKernelDotNetRoot)outputs\GeoKernel.NET.Wpf.Controls\$(GeoKernelSdkConfiguration)\net10.0-windows\GeoKernel.NET.Wpf.Controls.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyGeoKernelNativeRuntime" AfterTargets="Build">
    <ItemGroup>
      <GeoKernelNativeBinaries Include="$(GeoKernelRoot)outputs\GeoKernel.Core\$(GeoKernelSdkConfiguration)\GeoKernel.Core.dll" Condition="Exists('$(GeoKernelRoot)outputs\GeoKernel.Core\$(GeoKernelSdkConfiguration)\GeoKernel.Core.dll')" />
      <GeoKernelNativeBinaries Include="$(GeoKernelRoot)outputs\GeoKernel.Formats\$(GeoKernelSdkConfiguration)\GeoKernel.Formats.dll" Condition="Exists('$(GeoKernelRoot)outputs\GeoKernel.Formats\$(GeoKernelSdkConfiguration)\GeoKernel.Formats.dll')" />
      <GeoKernelNativeBinaries Include="$(GeoKernelRoot)outputs\GeoKernel.Viewer\$(GeoKernelSdkConfiguration)\*.dll" Condition="Exists('$(GeoKernelRoot)outputs\GeoKernel.Viewer\$(GeoKernelSdkConfiguration)\GeoKernel.Viewer.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(GeoKernelNativeBinaries)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'@(GeoKernelNativeBinaries)' != ''" />
  </Target>

  <ItemGroup>
    <Resource Include="..\..\images\GeoKernelAppIcon.ico" Link="Images\GeoKernelAppIcon.ico" />
  </ItemGroup>
</Project>
