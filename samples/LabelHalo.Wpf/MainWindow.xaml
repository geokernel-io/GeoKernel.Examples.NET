<Window x:Class="GeoKernel.LabelHalo.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="LabelHalo"
        Width="1200"
        Height="800"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#EFEFEF" Padding="8">
                <StackPanel>
                    <TextBlock Text="Label halo" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <CheckBox x:Name="haloEnabledCheckBox"
                              Content="Halo enabled"
                              IsChecked="True"
                              Margin="0,0,0,14"
                              Checked="HaloControl_Changed"
                              Unchecked="HaloControl_Changed" />

                    <TextBlock Text="Halo color" Margin="0,0,0,6" />
                    <ComboBox x:Name="haloColorComboBox"
                              Height="24"
                              Margin="0,0,0,12"
                              SelectionChanged="HaloControl_Changed" />

                    <TextBlock Text="Halo width" Margin="0,0,0,6" />
                    <Slider x:Name="haloWidthSlider"
                            Minimum="0.5"
                            Maximum="8.0"
                            Value="2.5"
                            TickFrequency="0.5"
                            IsSnapToTickEnabled="True"
                            ValueChanged="HaloControl_Changed" />
                    <TextBlock x:Name="haloWidthText" Text="2.5" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <gk:GeoKernelViewerControl x:Name="viewerControl"
                                       Grid.Column="1"
                                       MapBackgroundColor="#F7F8FA" />
        </Grid>

        <Border Grid.Row="1" Background="#F4F4F4" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="statusText" VerticalAlignment="Center" Margin="4,0" Text="Ready" />
        </Border>
    </Grid>
</Window>
