<Window x:Class="GeoKernel.StylePerFeature.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="StylePerFeature"
        Width="1100"
        Height="760"
        MinWidth="760"
        MinHeight="520"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="255" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Background="#EFEFEF"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,1,0"
                Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="132" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           VerticalAlignment="Center"
                           Text="Feature attributes" />

                <ListBox x:Name="featureListBox"
                         Grid.Row="1"
                         Margin="0,0,0,8"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="FeatureListBox_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Width="32"
                                           Height="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Fill="{Binding FillBrush}"
                                           Stroke="{Binding LineBrush}"
                                           StrokeThickness="2" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Text="{Binding DisplayText}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GroupBox Grid.Row="2"
                          Header="Selected Feature"
                          Padding="8">
                    <StackPanel>
                        <TextBlock Text="Zone attribute"
                                   Margin="0,0,0,6" />
                        <ComboBox x:Name="zoneComboBox"
                                  Height="24"
                                  Margin="0,0,0,10" />
                        <Button Height="32"
                                Content="Apply Feature Style"
                                Click="ApplyButton_Click" />
                    </StackPanel>
                </GroupBox>
            </Grid>
        </Border>

        <gk:GeoKernelViewerControl x:Name="viewerControl"
                                   Grid.Row="0"
                                   Grid.Column="1" />

        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                Background="#F4F4F4"
                BorderBrush="#D0D0D0"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="statusText"
                       VerticalAlignment="Center"
                       Margin="4,0"
                       Text="Ready" />
        </Border>
    </Grid>
</Window>
