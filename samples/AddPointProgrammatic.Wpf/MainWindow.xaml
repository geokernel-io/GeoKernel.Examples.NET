<Window x:Class="GeoKernel.AddPointProgrammatic.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="AddPointProgrammatic"
        Width="1200"
        Height="800"
        MinWidth="720"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Background="#F4F6F5"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#F1F1F1" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ToolbarIconStyle" TargetType="{x:Type Image}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F1F1F1">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="AddPoint_Click" Content="Add Point" />
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="ClearPoints_Click" Content="Clear Points" />
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="FullExtent_Click" ToolTip="Full Extent">
                    <StackPanel Orientation="Horizontal">
                        <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/FullExtent.png" />
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="Full Extent" />
                    </StackPanel>
                </Button>
                <Border Width="1" Height="24" Margin="4,4" Background="#C8C8C8" />
                <TextBlock x:Name="pointCountText"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Point count: 0" />
            </StackPanel>
        </Border>

        <gk:GeoKernelViewerControl x:Name="viewerControl" Grid.Row="1" MapBackgroundColor="#F4F6F5" />

        <StatusBar Grid.Row="2">
            <TextBlock x:Name="statusText" Text="Ready" />
        </StatusBar>
    </Grid>
</Window>
