<Window x:Class="GeoKernel.MultiLayerEdit.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="MultiLayerEdit"
        Width="1200"
        Height="800"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <ToolBarTray Grid.Row="0" Background="#EFEFEF">
            <ToolBar Height="32" Background="#EFEFEF" BorderThickness="0" Padding="0">
                <ToggleButton x:Name="redLayerButton" Padding="10,0" IsChecked="True" Click="RedLayer_Click">Active: Red Points</ToggleButton>
                <ToggleButton x:Name="blueLayerButton" Padding="10,0" Click="BlueLayer_Click">Active: Blue Points</ToggleButton>
                <Separator />
                <Button Padding="10,0" Click="AddToActiveLayer_Click">Add To Active Layer</Button>
                <Button Padding="10,0" Click="CommitBoth_Click">Commit Both</Button>
                <Button Padding="10,0" Click="RollbackBoth_Click">Rollback Both</Button>
                <Button Padding="10,0" Click="Reset_Click">Reset</Button>
                <Separator />
                <Button Padding="10,0" Click="FullExtent_Click">Full Extent</Button>
                <TextBlock x:Name="stateText" Margin="12,0,0,0" VerticalAlignment="Center" Text="Active edit layer: -" />
            </ToolBar>
        </ToolBarTray>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <gk:GeoKernelViewerControl x:Name="viewerControl" Grid.Column="0" MapBackgroundColor="#F4F6F5" />

            <TextBox x:Name="infoTextBox"
                     Grid.Column="1"
                     FontFamily="Consolas"
                     FontSize="12"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Background="White"
                     BorderThickness="1,0,0,0" />
        </Grid>

        <Border Grid.Row="2" Background="#F4F4F4" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="statusText" VerticalAlignment="Center" Margin="4,0" Text="Ready" />
        </Border>
    </Grid>
</Window>
