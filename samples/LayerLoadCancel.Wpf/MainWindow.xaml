<Window x:Class="GeoKernel.LayerLoadCancel.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="LayerLoadCancel"
        Width="1200"
        Height="800"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <ToolBarTray Grid.Row="0" Background="#EFEFEF">
            <ToolBar Height="32"
                     Background="#EFEFEF"
                     BorderThickness="0"
                     Padding="0">
                <Button x:Name="loadButton" Padding="10,0" Click="Load_Click">Load Large Layer</Button>
                <Button x:Name="cancelButton" Padding="10,0" Click="Cancel_Click" IsEnabled="False">Cancel</Button>
                <Button x:Name="clearButton" Padding="10,0" Click="Clear_Click">Clear</Button>
            </ToolBar>
        </ToolBarTray>

        <gk:GeoKernelViewerControl x:Name="viewerControl"
                                   Grid.Row="1"
                                   MapBackgroundColor="#F4F6F5" />

        <Grid Grid.Row="2" Background="#F4F4F4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="statusText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="4,0"
                       Text="Press Load Large Layer, then Cancel while loading." />
            <ProgressBar x:Name="progressBar"
                         Grid.Column="1"
                         Height="16"
                         Margin="4,3,6,3"
                         Minimum="0"
                         Maximum="100" />
        </Grid>
    </Grid>
</Window>
