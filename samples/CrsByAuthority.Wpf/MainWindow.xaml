<Window x:Class="GeoKernel.CrsByAuthority.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrsByAuthority"
        Width="1000"
        Height="720"
        MinWidth="720"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="8">
            <TextBlock Text="Authority:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="authorityComboBox" Width="110" IsEditable="True" Text="EPSG" Margin="0,0,8,0" KeyDown="AuthorityComboBox_KeyDown">
                <ComboBoxItem Content="EPSG" />
                <ComboBoxItem Content="ESRI" />
                <ComboBoxItem Content="IGNF" />
            </ComboBox>
            <TextBlock Text="Code:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="authoritySridTextBox" Width="110" Text="32635" Margin="0,0,8,0" KeyDown="AuthoritySridTextBox_KeyDown" />
            <Button Content="Find by Authority" Width="130" Margin="0,0,8,0" Click="FindButton_Click" />
            <TextBox x:Name="summaryTextBox" IsReadOnly="True" />
        </DockPanel>

        <TextBox x:Name="detailsTextBox"
                 Grid.Row="1"
                 FontFamily="Consolas"
                 FontSize="12"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />

        <StatusBar Grid.Row="2">
            <TextBlock x:Name="statusTextBlock" Text="CrsDatabase::findByAuthority" />
        </StatusBar>
    </Grid>
</Window>
