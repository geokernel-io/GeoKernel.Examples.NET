<Window x:Class="GeoKernel.PointCloudViewer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="PointCloudViewer — GeoKernel" Width="1200" Height="800"
        MinWidth="700" MinHeight="500" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="Preparing point cloud…" />
            <ProgressBar x:Name="Progress" Width="160" Height="15" IsIndeterminate="True" Margin="12,0" />
        </StatusBar>
        <ScrollViewer DockPanel.Dock="Left" Width="310" VerticalScrollBarVisibility="Auto" Background="#F0F0F0">
            <StackPanel Margin="12">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="Margin" Value="0,8,0,6" />
                    </Style>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="0,4" />
                        <Setter Property="Padding" Value="6" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="EuroSDR P4 — 40 × 40 m crop" FontWeight="SemiBold" />
                <TextBlock Text="Colour" />
                <ComboBox x:Name="Colors" SelectedIndex="0" IsEnabled="False" SelectionChanged="Colors_Changed">
                    <ComboBoxItem Content="RGB" />
                    <ComboBoxItem Content="Height" />
                </ComboBox>
                <TextBlock Text="Sample limit" />
                <ComboBox x:Name="Samples" SelectedIndex="2">
                    <ComboBoxItem Content="50,000" />
                    <ComboBoxItem Content="100,000" />
                    <ComboBoxItem Content="250,000" />
                </ComboBox>
                <Button x:Name="ReloadButton" Content="Load / apply sample limit" Click="Reload_Click" />
                <Button x:Name="CancelButton" Content="Cancel loading" IsEnabled="False" Click="Cancel_Click" />
                <TextBlock x:Name="Details" Text="No points loaded." />
                <TextBlock x:Name="Errors" />
                <Button Content="Reset view" Click="Reset_Click" />
                <TextBlock Text="Local normalized preview. Source coordinates remain EPSG:32630; heights are provisional. Display is sampled up to 250,000 points. Source points are preserved. Point size: 1 pixel (SDK fixed)." />
                <TextBlock Text="Left drag: pan&#10;Wheel/right drag: zoom&#10;Middle/Ctrl+left drag: orbit&#10;Shift+left drag: look" />
            </StackPanel>
        </ScrollViewer>
        <Border Background="#090F16">
            <gk:GeoKernelViewer3DControl x:Name="Viewer" PointCloudPreview="True" />
        </Border>
    </DockPanel>
</Window>
