<Window x:Class="GeoKernel.Tiles3DStreaming.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="Tiles3DStreaming — GeoKernel" Width="1400" Height="850"
        MinWidth="700" MinHeight="500" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="Preparing sample…" />
            <ProgressBar x:Name="Progress" Width="160" Height="15" IsIndeterminate="True" Margin="12,0" />
        </StatusBar>
        <ScrollViewer DockPanel.Dock="Left" Width="325" VerticalScrollBarVisibility="Auto" Background="#F0F0F0">
            <StackPanel Margin="12">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="Margin" Value="0,8,0,6" />
                    </Style>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="0,4" />
                        <Setter Property="Padding" Value="6" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="Sagrada Família — terrain and 3D Tiles" FontWeight="SemiBold" />
                <Button x:Name="ReloadButton" Content="Reload sample" Click="Reload_Click" />
                <Button x:Name="CancelButton" Content="Cancel loading" IsEnabled="False" Click="Cancel_Click" />
                <CheckBox x:Name="Imagery" Content="Show orthophoto" IsChecked="True" IsEnabled="False"
                          Margin="0,12" Checked="Imagery_Changed" Unchecked="Imagery_Changed" />
                <TextBlock Text="Camera movement selects tile detail automatically. Data streams from the downloaded local archive." />
                <TextBlock Text="CPU geometry batch budget (MiB)" />
                <ComboBox x:Name="Budget" SelectedIndex="1" IsEnabled="False">
                    <ComboBoxItem Content="64" /><ComboBoxItem Content="96" /><ComboBoxItem Content="128" />
                </ComboBox>
                <Button x:Name="StartButton" Content="Start / apply budget" IsEnabled="False" Click="Start_Click" />
                <Button x:Name="StopButton" Content="Stop streaming (keep current tiles)" IsEnabled="False" Click="Stop_Click" />
                <CheckBox x:Name="Buildings" Content="Show buildings" IsChecked="True" IsEnabled="False"
                          Margin="0,12" Checked="Buildings_Changed" Unchecked="Buildings_Changed" />
                <Button x:Name="FocusButton" Content="Focus loaded tiles" IsEnabled="False" Click="Focus_Click" />
                <TextBlock x:Name="Details" Text="No terrain loaded." />
                <TextBlock x:Name="Errors" />
                <Button Content="Reset view" Click="Reset_Click" />
                <TextBlock Text="Vertical exaggeration: 1×. DEM uses the regional EGM08D595 correction. Building/terrain alignment is approximate and not independently surveyed." />
                <TextBlock Text="Hiding clears the loaded model; showing restarts streaming. Stop may wait for in-flight work. Cache counters are not total RAM/VRAM usage." />
                <TextBlock Text="Left drag: pan&#10;Wheel/right drag: zoom&#10;Middle/Ctrl+left drag: orbit" />
            </StackPanel>
        </ScrollViewer>
        <Border Background="#090F16"><gk:GeoKernelViewer3DControl x:Name="Viewer" /></Border>
    </DockPanel>
</Window>
