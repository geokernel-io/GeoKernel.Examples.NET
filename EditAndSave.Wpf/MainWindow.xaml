<Window x:Class="GeoKernel.EditAndSave.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="EditAndSave"
        Width="1200"
        Height="800"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="ToolbarToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#D2E8F7" />
                    <Setter Property="BorderBrush" Value="#0078D7" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarIconStyle" TargetType="Image">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F1F1F1" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Full Extent" Click="FullExtent_Click">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/FullExtent.png" />
                </Button>
                <Border Width="1" Height="28" Margin="4,6" Background="#C8C8C8" />
                <ToggleButton x:Name="addPointButton" Style="{StaticResource ToolbarToggleStyle}" IsChecked="True" ToolTip="Add Point" Click="AddPoint_Click">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/Point.png" />
                </ToggleButton>
                <ToggleButton x:Name="panButton" Style="{StaticResource ToolbarToggleStyle}" ToolTip="Pan" Click="Pan_Click">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/Pan.png" />
                </ToggleButton>
                <Border Width="1" Height="28" Margin="4,6" Background="#C8C8C8" />
                <Button x:Name="saveButton" Style="{StaticResource ToolbarButtonStyle}" IsEnabled="False" ToolTip="Save Shapefile" Click="Save_Click">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/SaveProject.png" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Clear Points" Click="Clear_Click">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/Delete.png" />
                </Button>
                <TextBlock x:Name="countText" Margin="12,0" VerticalAlignment="Center" Text="Point count: 0" />
            </StackPanel>
        </Border>

        <gk:GeoKernelViewerControl x:Name="viewerControl" Grid.Row="1" MapMouseUp="ViewerControl_MapMouseUp" />

        <StatusBar Grid.Row="2">
            <TextBlock x:Name="statusText" Text="Choose Add Point, click the map, then save the points as a shapefile." />
        </StatusBar>
    </Grid>
</Window>
