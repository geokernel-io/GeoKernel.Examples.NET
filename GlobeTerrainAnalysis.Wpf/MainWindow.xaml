<Window x:Class="GeoKernel.GlobeTerrainAnalysis.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="GeoKernel — Barcelona Terrain Analysis" Width="1200" Height="800"
        MinWidth="850" MinHeight="550" WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>
        <ToolBar x:Name="Toolbar" IsEnabled="False" ToolBarTray.IsLocked="True">
            <ToggleButton x:Name="LineOfSight" Content="Line of sight" Tag="0" Click="SelectTool" />
            <ToggleButton x:Name="Viewshed" Content="Viewshed" Tag="1" Click="SelectTool" />
            <ToggleButton x:Name="Slope" Content="Slope / aspect" Tag="2" Click="SelectTool" />
            <ToggleButton x:Name="MeasureTool" Content="Measure" Tag="3" Click="SelectTool" />
            <Button x:Name="Clear" Content="Clear" Click="ClearTool" />
            <Button x:Name="Barcelona" Content="Barcelona" Click="GoToBarcelona" />
        </ToolBar>
        <gk:GeoKernelGlobeControl x:Name="GlobeView" Grid.Row="1" GlobeReady="GlobeReady" GlobeEventReceived="OnGlobeEvent" />
        <TextBox x:Name="Result" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Padding="8"
                 Text="Choose an analysis tool, then click the terrain. Drag to navigate; Esc cancels selection." />
        <Border Grid.Row="3" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <TextBlock x:Name="Status" Text="Loading Barcelona terrain…" Margin="6,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Border>
    </Grid>
</Window>

