<Window x:Class="GeoKernel.AddLayers.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="AddLayers"
        Width="1200"
        Height="800"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Background="#F4F6F5"
        Loaded="Window_Loaded">
    
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#F1F1F1" />
            <Setter Property="BorderBrush" Value="#F1F1F1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ToolbarToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#F1F1F1" />
            <Setter Property="BorderBrush" Value="#F1F1F1" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#D9ECFF" />
                    <Setter Property="BorderBrush" Value="#0078D7" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarIconStyle" TargetType="{x:Type Image}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="39" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F1F1F1">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="ZoomIn_Click" ToolTip="Zoom In">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/ZoomIn.png" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="ZoomOut_Click" ToolTip="Zoom Out">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/ZoomOut.png" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="FullExtent_Click" ToolTip="Full Extent">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/FullExtent.png" />
                </Button>
                <Border Width="1" Height="32" Margin="4,3" Background="#C8C8C8" />
                <ToggleButton x:Name="zoomRectButton" Style="{StaticResource ToolbarToggleStyle}" Click="ZoomRect_Click" ToolTip="Zoom Rect">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/RectangularZoom.png" />
                </ToggleButton>
                <ToggleButton x:Name="panButton" Style="{StaticResource ToolbarToggleStyle}" Click="Pan_Click" ToolTip="Pan">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/Pan.png" />
                </ToggleButton>
            </StackPanel>
        </Border>

        <gk:GeoKernelViewerControl x:Name="viewerControl" Grid.Row="1" />
    </Grid>
</Window>
