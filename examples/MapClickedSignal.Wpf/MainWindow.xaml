<Window x:Class="GeoKernel.MapClickedSignal.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="MapClickedSignal"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <ToolBarTray Grid.Row="0" Background="#EFEFEF">
            <ToolBar Height="32"
                     Background="#EFEFEF"
                     BorderThickness="0"
                     Padding="0"
                     Band="0"
                     BandIndex="0">
                <ToggleButton x:Name="infoButton"
                              Padding="10,0"
                              IsChecked="True"
                              Click="Info_Click">Info</ToggleButton>
                <ToggleButton x:Name="panButton"
                              Padding="10,0"
                              Click="Pan_Click">Pan</ToggleButton>
                <Separator />
                <Button Padding="10,0" Click="FullExtent_Click">Full Extent</Button>
                <TextBlock x:Name="toolStateText"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Signal: mapClicked(tool, screenPoint, worldPoint, modifiers)" />
            </ToolBar>
        </ToolBarTray>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="446" />
            </Grid.ColumnDefinitions>

            <gk:GeoKernelViewerControl x:Name="viewerControl"
                                       Grid.Column="0"
                                       MapBackgroundColor="#F4F6F5"
                                       MouseLeftButtonUp="ViewerControl_MouseLeftButtonUp" />

            <DataGrid x:Name="logGrid"
                      Grid.Column="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="82" />
                    <DataGridTextColumn Header="Tool" Binding="{Binding Tool}" Width="72" />
                    <DataGridTextColumn Header="Screen point" Binding="{Binding ScreenPoint}" Width="120" />
                    <DataGridTextColumn Header="World point" Binding="{Binding WorldPoint}" Width="140" />
                    <DataGridTextColumn Header="Modifiers" Binding="{Binding Modifiers}" Width="80" />
                    <DataGridTextColumn Header="Hit layer" Binding="{Binding HitLayer}" Width="100" />
                    <DataGridTextColumn Header="Feature ID" Binding="{Binding FeatureId}" Width="80" />
                    <DataGridTextColumn Header="Shape type" Binding="{Binding ShapeType}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="2" Background="#F4F4F4" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="statusText"
                       VerticalAlignment="Center"
                       Margin="4,0"
                       Text="Ready" />
        </Border>
    </Grid>
</Window>
