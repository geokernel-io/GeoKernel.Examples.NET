<Window x:Class="GeoKernel.AllFeaturesAtPoint.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="AllFeaturesAtPoint"
        Width="1200"
        Height="800"
        MinWidth="950"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <ToolBarTray Grid.Row="0" Background="#EFEFEF">
            <ToolBar Height="32"
                     Background="#EFEFEF"
                     BorderThickness="0"
                     Padding="0"
                     Band="0"
                     BandIndex="0">
                <ToggleButton x:Name="identifyButton"
                              Padding="10,0"
                              IsChecked="True"
                              Click="Identify_Click">All Features Here</ToggleButton>
                <ToggleButton x:Name="panButton"
                              Padding="10,0"
                              Click="Pan_Click">Pan</ToggleButton>
                <Separator />
                <Button Padding="10,0" Click="FullExtent_Click">Full Extent</Button>
                <TextBlock x:Name="toolStateText"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Tool: hitTestFeaturesAt" />
            </ToolBar>
        </ToolBarTray>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="356" />
            </Grid.ColumnDefinitions>

            <gk:GeoKernelViewerControl x:Name="viewerControl" Grid.Column="0" MouseLeftButtonUp="ViewerControl_MouseLeftButtonUp" />

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="270" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="hitsGrid"
                          Grid.Row="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionChanged="HitsGrid_SelectionChanged"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="42" />
                        <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="*" />
                        <DataGridTextColumn Header="Shape" Binding="{Binding ShapeId}" Width="62" />
                        <DataGridTextColumn Header="Type" Binding="{Binding ShapeType}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid x:Name="attributesGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Property / Field" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#F4F4F4" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="statusText"
                       VerticalAlignment="Center"
                       Margin="4,0"
                       Text="Ready" />
        </Border>
    </Grid>
</Window>
