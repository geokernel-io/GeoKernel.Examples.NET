<Window x:Class="GeoKernel.AddPointInteractive.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="AddPointInteractive"
        Width="1200"
        Height="800"
        MinWidth="720"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Background="#F4F6F5"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#F1F1F1" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ToolbarToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#F1F1F1" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#D9ECFF" />
                    <Setter Property="BorderBrush" Value="#0078D7" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarIconStyle" TargetType="{x:Type Image}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F1F1F1">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Click="FullExtent_Click"
                        ToolTip="Full Extent">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/FullExtent.png" />
                </Button>
                <Border Width="1" Height="24" Margin="4,4" Background="#C8C8C8" />
                <ToggleButton x:Name="addPointButton" Style="{StaticResource ToolbarToggleStyle}" IsChecked="True" Click="AddPoint_Click" ToolTip="Add Point">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/Point.png" />
                </ToggleButton>
                <ToggleButton x:Name="panButton"
                              Style="{StaticResource ToolbarToggleStyle}"
                              Click="Pan_Click"
                              ToolTip="Pan">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/Pan.png" />
                </ToggleButton>
                <Border Width="1" Height="24" Margin="4,4" Background="#C8C8C8" />
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="ClearPoints_Click" ToolTip="Clear Points">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/Delete.png" />
                </Button>
                <TextBlock x:Name="pointCountText"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Text="Point count: 0" />
            </StackPanel>
        </Border>

        <gk:GeoKernelViewerControl x:Name="viewerControl" Grid.Row="1" MapBackgroundColor="#F4F6F5" />

        <StatusBar Grid.Row="2">
            <TextBlock x:Name="statusText" Text="Ready" />
        </StatusBar>
    </Grid>
</Window>
