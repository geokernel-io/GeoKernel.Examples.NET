<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <PackageReference Include="GeoKernel.NET.Wpf.Controls" Version="1.0.7" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\images\ZoomIn.png" Link="Images\ZoomIn.png" />
    <Resource Include="..\..\images\ZoomOut.png" Link="Images\ZoomOut.png" />
    <Resource Include="..\..\images\FullExtent.png" Link="Images\FullExtent.png" />
    <Resource Include="..\..\images\RectangularZoom.png" Link="Images\RectangularZoom.png" />
    <Resource Include="..\..\images\Pan.png" Link="Images\Pan.png" />
    <Resource Include="..\..\images\GeoKernelAppIcon.ico" Link="Images\GeoKernelAppIcon.ico" />
  </ItemGroup>
</Project>
