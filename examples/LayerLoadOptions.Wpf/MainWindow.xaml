<Window x:Class="GeoKernel.LayerLoadOptions.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="LayerLoadOptions"
        Width="1200"
        Height="800"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <ToolBarTray Grid.Row="0" Background="#EFEFEF">
            <ToolBar Height="32"
                     Background="#EFEFEF"
                     BorderThickness="0"
                     Padding="0">
                <Button Padding="10,0" Click="LoadNoIndex_Click">Load No Index</Button>
                <Button Padding="10,0" Click="LoadRTree_Click">Load RTree</Button>
                <Button Padding="10,0" Click="RunQueryTest_Click">Run Query Test</Button>
                <Button Padding="10,0" Click="Clear_Click">Clear</Button>
            </ToolBar>
        </ToolBarTray>

        <StackPanel Grid.Row="1" Margin="6,4,6,4">
            <TextBlock Text="Load one index mode, then run the query test. Load time is shown separately and is not part of the test result." />
            <TextBlock x:Name="noIndexResultText" Margin="0,7,0,0" Text="No Index: -" />
            <TextBlock x:Name="rtreeResultText" Margin="0,4,0,0" Text="RTree: -" />
        </StackPanel>

        <gk:GeoKernelViewerControl x:Name="viewerControl"
                                   Grid.Row="2" />

        <Grid Grid.Row="3" Background="#F4F4F4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="statusText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="4,0"
                       Text="Ready." />
            <ProgressBar x:Name="progressBar"
                         Grid.Column="1"
                         Height="16"
                         Margin="4,3,6,3"
                         Minimum="0"
                         Maximum="100" />
        </Grid>
    </Grid>
</Window>
