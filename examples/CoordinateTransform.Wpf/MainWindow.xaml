<Window x:Class="GeoKernel.CoordinateTransform.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="CoordinateTransform"
        Width="1200"
        Height="800"
        MinWidth="720"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F5"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F1F1F1">
            <Button Width="88"
                    Height="27"
                    Margin="4"
                    HorizontalAlignment="Left"
                    Content="Full Extent"
                    Click="FullExtent_Click" />
        </Border>

        <gk:GeoKernelViewerControl x:Name="viewerControl"
                                   Grid.Row="1"
                                   MapBackgroundColor="#F4F6F5" />

        <StatusBar Grid.Row="2">
            <TextBlock x:Name="statusTextBlock" Text="EPSG:4326 -> EPSG:3857" />
        </StatusBar>
    </Grid>
</Window>
