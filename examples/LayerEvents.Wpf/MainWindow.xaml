<Window x:Class="GeoKernel.LayerEvents.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="LayerEvents"
        Width="1280"
        Height="820"
        MinWidth="760"
        MinHeight="520"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="1.35*" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Margin="0,0,0,6" Content="Add World" Click="AddWorld_Click" />
                <Button Grid.Row="1" Margin="0,0,0,6" Content="Add States" Click="AddStates_Click" />
                <Button Grid.Row="2" Margin="0,0,0,6" Content="Add Cities" Click="AddCities_Click" />
                <Button Grid.Row="3" Margin="0,0,0,6" Content="Remove Selected" Click="RemoveSelected_Click" />
                <Button Grid.Row="4" Margin="0,0,0,6" Content="Clear Layers" Click="ClearLayers_Click" />
                <Button Grid.Row="5" Margin="0,0,0,6" Content="Toggle Visibility" Click="ToggleVisibility_Click" />
                <Button Grid.Row="6" Margin="0,0,0,6" Content="Move Up" Click="MoveUp_Click" />
                <Button Grid.Row="7" Margin="0,0,0,6" Content="Move Down" Click="MoveDown_Click" />
                <Button Grid.Row="8" Margin="0,0,0,6" Content="Refresh" Click="Refresh_Click" />
                <Button Grid.Row="9" Margin="0,0,0,6" Content="Clear Log" Click="ClearLog_Click" />

                <ListBox x:Name="layerListBox"
                         Grid.Row="10"
                         Margin="0,0,0,8" />

                <TextBox x:Name="eventLogTextBox"
                         Grid.Row="11"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </Grid>

            <gk:GeoKernelViewerControl x:Name="viewerControl"
                                       Grid.Column="1"
                                       MapBackgroundColor="#F4F6F5" />
        </Grid>

        <Border Grid.Row="1" Background="#F4F4F4" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="statusText"
                       VerticalAlignment="Center"
                       Margin="4,0"
                       Text="Ready" />
        </Border>
    </Grid>
</Window>
