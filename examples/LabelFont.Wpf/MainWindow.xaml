<Window x:Class="GeoKernel.LabelFont.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="LabelFont"
        Width="1200"
        Height="800"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#EFEFEF" Padding="8">
                <StackPanel>
                    <TextBlock Text="Label font" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <TextBlock Text="Font family" Margin="0,0,0,6" />
                    <ComboBox x:Name="fontFamilyComboBox"
                              Height="24"
                              Margin="0,0,0,12"
                              SelectionChanged="LabelFontControl_Changed" />

                    <CheckBox x:Name="boldCheckBox"
                              Content="Bold"
                              Margin="0,0,0,10"
                              Checked="LabelFontControl_Changed"
                              Unchecked="LabelFontControl_Changed" />

                    <CheckBox x:Name="italicCheckBox"
                              Content="Italic"
                              Checked="LabelFontControl_Changed"
                              Unchecked="LabelFontControl_Changed" />
                </StackPanel>
            </Border>

            <gk:GeoKernelViewerControl x:Name="viewerControl"
                                       Grid.Column="1" />
        </Grid>

        <Border Grid.Row="1" Background="#F4F4F4" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="statusText" VerticalAlignment="Center" Margin="4,0" Text="Ready" />
        </Border>
    </Grid>
</Window>
