<Window x:Class="GeoKernel.LayerAddRemove.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="LayerAddRemove"
        Width="1200"
        Height="800"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Background="#F4F6F5"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F1F1F1">
            <StackPanel Orientation="Horizontal">
                <Button Padding="10,0" Margin="0" Click="AddWorld_Click">Add World</Button>
                <Button Padding="10,0" Margin="0" Click="AddStates_Click">Add States</Button>
                <Button Padding="10,0" Margin="0" Click="AddCities_Click">Add Cities</Button>
                <Border Width="1" Height="24" Margin="6,4" Background="#C8C8C8" />
                <Button Padding="10,0" Margin="0" Click="RemoveWorld_Click">Remove World</Button>
                <Button Padding="10,0" Margin="0" Click="RemoveStates_Click">Remove States</Button>
                <Button Padding="10,0" Margin="0" Click="RemoveCities_Click">Remove Cities</Button>
                <Border Width="1" Height="24" Margin="6,4" Background="#C8C8C8" />
                <Button Padding="10,0" Margin="0" Click="ClearLayers_Click">Clear Layers</Button>
            </StackPanel>
        </Border>

        <gk:GeoKernelViewerControl x:Name="viewerControl" Grid.Row="1" />

        <Border Grid.Row="2" Background="#F1F1F1">
            <TextBlock x:Name="statusText" Margin="4,0" VerticalAlignment="Center" Text="Layers: 0" />
        </Border>
    </Grid>
</Window>
