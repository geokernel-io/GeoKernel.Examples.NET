<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
<OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeoKernel.LabelOffset.Wpf</RootNamespace>
    <AssemblyName>LabelOffset.Wpf</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\images\GeoKernelAppIcon.ico" Link="Images\GeoKernelAppIcon.ico" />
  </ItemGroup>
<ItemGroup>
    <PackageReference Include="GeoKernel.NET.Wpf.Controls" Version="$(GeoKernelDotNetPackageVersion)" />
  </ItemGroup>
</Project>

