<Window x:Class="GeoKernel.GlobeVectorStyling.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="GeoKernel — Sagrada Familia Building Styles" Width="1200" Height="800"
        MinWidth="900" MinHeight="480" WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>
        <ToolBar x:Name="Toolbar" IsEnabled="False" ToolBarTray.IsLocked="True">
            <ToggleButton x:Name="Fill" Content="Fill" IsChecked="True" Click="ApplyStyle" />
            <ToggleButton x:Name="Labels" Content="Labels" Click="ApplyStyle" />
            <TextBlock Text="Color by:" VerticalAlignment="Center" Margin="4,0" />
            <ComboBox x:Name="Category" Width="100" SelectionChanged="ApplyStyle" />
            <TextBlock Text="Label:" VerticalAlignment="Center" Margin="4,0" />
            <ComboBox x:Name="LabelField" Width="100" SelectionChanged="ApplyStyle" />
            <TextBlock Text="Opacity:" VerticalAlignment="Center" Margin="4,0" />
            <Slider x:Name="LayerOpacity" Width="100" Minimum="15" Maximum="100" Value="60"
                    VerticalAlignment="Center" ValueChanged="OpacityChanged" />
            <Button Content="Base color…" Click="ChooseColor" />
            <Button Content="Zoom to buildings" Click="ZoomToBuildings" />
            <ToggleButton x:Name="Esri" Content="Esri" IsChecked="True" Click="ToggleEsri" />
        </ToolBar>
        <gk:GeoKernelGlobeControl x:Name="GlobeView" Grid.Row="1" GlobeReady="GlobeReady" />
        <Border Grid.Row="2" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <TextBlock x:Name="Status" Text="Preparing globe…" Margin="6,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Border>
    </Grid>
</Window>
