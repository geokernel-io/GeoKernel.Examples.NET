<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>..\Images\GeoKernelAppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <PackageReference Include="GeoKernel.NET" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\Images\GeoKernelAppIcon.ico" Link="Images\GeoKernelAppIcon.ico" />
    <Resource Include="..\Images\FullExtent.png" Link="Images\FullExtent.png" />
    <Resource Include="..\Images\Polygon.png" Link="Images\Polygon.png" />
    <Resource Include="..\Images\Pan.png" Link="Images\Pan.png" />
    <Resource Include="..\Images\Delete.png" Link="Images\Delete.png" />
  </ItemGroup>
</Project>
