<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><Nullable>enable</Nullable><UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><PlatformTarget>x64</PlatformTarget><AssemblyName>ObjectDetectionInference</AssemblyName><ApplicationIcon>..\Images\GeoKernelAppIcon.ico</ApplicationIcon></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\GeoKernel.NET\GeoKernel.NET.WinForms.Controls\GeoKernel.NET.WinForms.Controls.csproj" />
    <Content Include="$(NuGetPackageRoot)geokernel.net\1.5.14\runtimes\win-x64\native\**\*" Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><Content Include="..\Images\GeoKernelAppIcon.ico"><Link>resources\GeoKernelAppIcon.ico</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content></ItemGroup>
  <Target Name="CopyLocalGeoKernelRuntime" AfterTargets="Build" BeforeTargets="Run" Condition="Exists('D:\projects\GeoKernel\outputs\build\Release\GeoKernel.Analysis.dll')">
    <ItemGroup><LocalGeoKernelRuntime Include="D:\projects\GeoKernel\outputs\build\Release\GeoKernel*.dll" /></ItemGroup>
    <Copy SourceFiles="@(LocalGeoKernelRuntime)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="false" />
  </Target>
</Project>
