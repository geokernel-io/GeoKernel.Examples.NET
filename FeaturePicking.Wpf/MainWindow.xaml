<Window x:Class="GeoKernel.FeaturePicking.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="FeaturePicking — GeoKernel" Width="1200" Height="850"
        MinWidth="750" MinHeight="500" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closed="Window_Closed" PreviewKeyDown="Window_KeyDown">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="Preparing sample…" />
            <ProgressBar x:Name="Progress" Width="160" Height="15" IsIndeterminate="True" Margin="12,0" />
        </StatusBar>
        <ScrollViewer DockPanel.Dock="Left" Width="320" VerticalScrollBarVisibility="Auto" Background="#F0F0F0">
            <StackPanel Margin="12">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="Margin" Value="0,6" />
                    </Style>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="0,4" />
                        <Setter Property="Padding" Value="6" />
                    </Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Margin" Value="0,5" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="Sagrada Família — feature picking" FontWeight="SemiBold" />
                <TextBlock Text="Click a building or road to inspect its source attributes. Drag to navigate." />
                <Button x:Name="ReloadButton" Content="Reload sample" Click="Reload_Click" />
                <Button x:Name="CancelButton" Content="Cancel loading" IsEnabled="False" Click="Cancel_Click" />
                <CheckBox x:Name="Imagery" Content="Show orthophoto" IsChecked="True" IsEnabled="False"
                          Checked="Imagery_Changed" Unchecked="Imagery_Changed" />
                <CheckBox x:Name="Buildings" Content="Show buildings" IsChecked="True" IsEnabled="False"
                          Checked="Layers_Changed" Unchecked="Layers_Changed" />
                <CheckBox x:Name="Roads" Content="Show roads" IsChecked="True" IsEnabled="False"
                          Checked="Layers_Changed" Unchecked="Layers_Changed" />
                <CheckBox x:Name="Multiple" Content="Multiple selection (click to add/remove)" IsEnabled="False"
                          Checked="Multiple_Changed" Unchecked="Multiple_Changed" />
                <TextBlock x:Name="SelectionCount" Text="No selection" />
                <ComboBox x:Name="SelectedFeature" IsEnabled="False" SelectionChanged="SelectedFeature_Changed" />
                <DataGrid x:Name="Attributes" Height="240" Margin="0,8" IsReadOnly="True"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="*" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <Button x:Name="FocusButton" Content="Zoom to selection" IsEnabled="False" Click="Focus_Click" />
                <Button x:Name="ClearButton" Content="Clear selection (Esc)" IsEnabled="False" Click="Clear_Click" />
                <TextBlock Text="Vertical exaggeration" />
                <Slider x:Name="HeightScale" Minimum="0.25" Maximum="10" Value="1"
                        TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="Height_Changed" />
                <TextBlock Text="{Binding ElementName=HeightScale, Path=Value, StringFormat={}{0:F2} ×}" />
                <Button Content="Reset view" Click="Reset_Click" />
                <TextBlock Text="Building heights are illustrative (9 m), not measured. DEM heights are metres; the vertical datum is unverified." />
                <TextBlock Text="Left drag: pan&#10;Wheel/right drag: zoom&#10;Middle/Ctrl+left drag: orbit" />
            </StackPanel>
        </ScrollViewer>
        <Border Background="#090F16">
            <gk:GeoKernelViewer3DControl x:Name="Viewer" />
        </Border>
    </DockPanel>
</Window>
