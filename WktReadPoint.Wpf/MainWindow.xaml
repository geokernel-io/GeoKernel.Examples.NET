<Window x:Class="GeoKernel.WktReadPoint.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="WktReadPoint"
        Width="1000"
        Height="700"
        MinWidth="760"
        MinHeight="500"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <DockPanel>
        <Grid DockPanel.Dock="Top"
              Margin="6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="WKT:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBox x:Name="wktTextBox"
                     Grid.Column="1"
                     Text="POINT(-122.4194 37.7749)"
                     VerticalContentAlignment="Center"
                     KeyDown="WktTextBox_KeyDown" />
            <Button Grid.Column="2"
                    Content="Read Point"
                    Margin="8,0,0,0"
                    Padding="10,2"
                    Click="ReadPoint_Click" />
            <Button Grid.Column="3"
                    Content="Reset"
                    Margin="6,0,0,0"
                    Padding="10,2"
                    Click="Reset_Click" />
        </Grid>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="statusText" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <gk:GeoKernelViewerControl x:Name="viewerControl"
                                       Grid.Column="0" />

            <TextBox x:Name="detailsTextBox"
                     Grid.Column="1"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>
    </DockPanel>
</Window>
