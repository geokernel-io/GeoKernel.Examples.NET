<Window x:Class="GeoKernel.LayerStylingAndFiltering.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="LayerStylingAndFiltering — GeoKernel" Width="1250" Height="850"
        MinWidth="800" MinHeight="500" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="Preparing sample…" />
            <ProgressBar x:Name="Progress" Width="150" Height="15" IsIndeterminate="True" Margin="12,0" />
        </StatusBar>
        <ScrollViewer DockPanel.Dock="Left" Width="330" VerticalScrollBarVisibility="Auto" Background="#F0F0F0">
            <StackPanel Margin="12">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="Margin" Value="0,6" />
                    </Style>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="0,4" />
                        <Setter Property="Padding" Value="6" />
                    </Style>
                    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,5" /></Style>
                </StackPanel.Resources>
                <TextBlock Text="Sagrada Família — layer styling and filtering" FontWeight="SemiBold" />
                <Button x:Name="ReloadButton" Content="Reload sample" Click="Reload_Click" />
                <Button x:Name="CancelButton" Content="Cancel loading" IsEnabled="False" Click="Cancel_Click" />
                <CheckBox x:Name="Imagery" Content="Show orthophoto" IsChecked="True" IsEnabled="False"
                          Checked="Imagery_Changed" Unchecked="Imagery_Changed" />
                <StackPanel x:Name="Styles" IsEnabled="False">
                    <TextBlock Text="Layer" />
                    <ComboBox x:Name="Layer" SelectionChanged="Layer_Changed" />
                    <CheckBox x:Name="LayerVisible" Content="Visible" Checked="Appearance_Changed" Unchecked="Appearance_Changed" />
                    <TextBlock Text="Opacity (%)" />
                    <Slider x:Name="LayerOpacity" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Appearance_Changed" />
                    <TextBlock Text="{Binding ElementName=LayerOpacity, Path=Value, StringFormat={}{0:F0}%}" />
                    <Button x:Name="ColorButton" Content="Choose uniform color" Click="Color_Click" />
                    <Button Content="Restore source color" Click="Source_Click" />
                    <TextBlock Text="Color by attribute" />
                    <ComboBox x:Name="Theme" SelectionChanged="Theme_Changed" />
                    <TextBlock Text="Filter attribute" />
                    <ComboBox x:Name="Field" SelectionChanged="Field_Changed" />
                    <TextBlock Text="Contains (case-insensitive)" />
                    <TextBox x:Name="FilterText" TextChanged="FilterText_Changed" />
                    <TextBlock Text="Example values (up to 200)" />
                    <ComboBox x:Name="Values" SelectionChanged="Values_Changed" />
                    <Button Content="Clear this filter" Click="Clear_Click" />
                    <TextBlock x:Name="Count" Text="No layer loaded." />
                    <Button x:Name="FocusButton" Content="Zoom to matching features" Click="Focus_Click" />
                    <Button Content="Reset all styles and filters" Click="ResetStyles_Click" />
                </StackPanel>
                <TextBlock Text="Vertical exaggeration" />
                <Slider x:Name="HeightScale" Minimum="0.25" Maximum="10" Value="1" TickFrequency="0.25"
                        IsSnapToTickEnabled="True" ValueChanged="Height_Changed" />
                <TextBlock Text="{Binding ElementName=HeightScale, Path=Value, StringFormat={}{0:F2} ×}" />
                <Button Content="Reset view" Click="Reset_Click" />
                <TextBlock Text="Filters use literal substring matching and affect drawing and selection. Attribute coloring overrides uniform color. Settings are session-only." />
                <TextBlock Text="Counts include records without drawable geometry. Building heights are illustrative (9 m). DEM heights are metres; the vertical datum is unverified." />
                <TextBlock Text="Left drag: pan&#10;Wheel/right drag: zoom&#10;Middle/Ctrl+left drag: orbit" />
            </StackPanel>
        </ScrollViewer>
        <Border Background="#090F16"><gk:GeoKernelViewer3DControl x:Name="Viewer" /></Border>
    </DockPanel>
</Window>
