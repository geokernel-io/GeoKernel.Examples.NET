<Window x:Class="GeoKernel.MultiWindowSync.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="MultiWindowSync"
        Width="1280"
        Height="760"
        MinWidth="760"
        MinHeight="520"
        Icon="Images/GeoKernelAppIcon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F5"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#F1F1F1" />
            <Setter Property="BorderBrush" Value="#F1F1F1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ToolbarToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#F1F1F1" />
            <Setter Property="BorderBrush" Value="#F1F1F1" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#D9ECFF" />
                    <Setter Property="BorderBrush" Value="#0078D7" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarTextToggleStyle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource ToolbarToggleStyle}">
            <Setter Property="Width" Value="76" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style x:Key="ToolbarIconStyle" TargetType="{x:Type Image}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="39" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F1F1F1">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="ZoomIn_Click" ToolTip="Zoom In">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="pack://application:,,,/images/zoomin.png" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="ZoomOut_Click" ToolTip="Zoom Out">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="pack://application:,,,/images/zoomout.png" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="FullExtent_Click" ToolTip="Full Extent">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="pack://application:,,,/images/fullextent.png" />
                </Button>
                <ToggleButton x:Name="syncButton"
                              Style="{StaticResource ToolbarTextToggleStyle}"
                              Content="Sync On"
                              IsChecked="True"
                              Click="Sync_Click" />
                <Border Width="1" Height="32" Margin="4,3" Background="#C8C8C8" />
                <ToggleButton x:Name="zoomRectButton"
                              Style="{StaticResource ToolbarToggleStyle}"
                              Click="ZoomRect_Click"
                              ToolTip="Zoom Rect">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="pack://application:,,,/images/rectangularzoom.png" />
                </ToggleButton>
                <ToggleButton x:Name="panButton"
                              Style="{StaticResource ToolbarToggleStyle}"
                              IsChecked="True"
                              Click="Pan_Click"
                              ToolTip="Pan">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="pack://application:,,,/images/pan.png" />
                </ToggleButton>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#EEF2F1" BorderBrush="#C7D1CE" BorderThickness="0,0,0,1">
                    <TextBlock Text="Viewer A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <gk:GeoKernelViewerControl x:Name="leftViewerControl"
                                           Grid.Row="1" />
            </Grid>

            <Border Grid.Column="1" Background="#D0D7D5" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#EEF2F1" BorderBrush="#C7D1CE" BorderThickness="0,0,0,1">
                    <TextBlock Text="Viewer B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <gk:GeoKernelViewerControl x:Name="rightViewerControl"
                                           Grid.Row="1" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#F4F4F4" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="statusText"
                       VerticalAlignment="Center"
                       Margin="4,0"
                       Text="Sync enabled. Drive Viewer A." />
        </Border>
    </Grid>
</Window>
