<Window x:Class="GeoKernel.RasterTileCache.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls" Title="RasterTileCache" Width="1180" Height="760" MinWidth="720" MinHeight="460" WindowStartupLocation="CenterScreen" Icon="Images/GeoKernelAppIcon.ico" Loaded="Window_Loaded">
 <DockPanel Background="#F4F6F5">
  <StackPanel DockPanel.Dock="Top" Height="38" Orientation="Horizontal" Background="#F1F1F1">
   <Button Margin="4,5,2,5" Padding="9,0" Click="LoadDisabled_Click">Load Cache Disabled</Button><Button Margin="2,5" Padding="9,0" Click="LoadSmall_Click">Load Small Budget</Button><Button Margin="2,5" Padding="9,0" Click="LoadLarge_Click">Load Large Budget</Button><Button Margin="2,5" Padding="9,0" Click="Benchmark_Click">Run Tile Benchmark</Button><Button Margin="2,5" Padding="9,0" Click="ClearCache_Click">Clear Tile Cache</Button><Button Margin="2,5" Padding="9,0" Click="FullExtent_Click">Full Extent</Button>
  </StackPanel>
  <StatusBar DockPanel.Dock="Bottom" Height="24"><TextBlock x:Name="statusText" Text="Ready."/><ProgressBar x:Name="progressBar" Width="180" Height="16" Margin="12,0,0,0" Minimum="0" Maximum="100"/></StatusBar>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions><gk:GeoKernelViewerControl x:Name="viewerControl"/><TextBox x:Name="detailsTextBox" Grid.Column="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/></Grid>
 </DockPanel>
</Window>
