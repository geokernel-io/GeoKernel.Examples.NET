<Window x:Class="GeoKernel.EditSession.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="EditSession"
        Width="1200"
        Height="800"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <ToolBarTray Grid.Row="0" Background="#EFEFEF">
            <ToolBar Height="32"
                     Background="#EFEFEF"
                     BorderThickness="0"
                     Padding="0"
                     Band="0"
                     BandIndex="0">
                <Button x:Name="beginEditButton" Padding="10,0" Click="BeginEdit_Click">Begin Edit</Button>
                <Button x:Name="addFeatureButton" Padding="10,0" Click="AddFeature_Click" IsEnabled="False">Add Feature</Button>
                <Separator />
                <Button x:Name="commitEditButton" Padding="10,0" Click="CommitEdit_Click" IsEnabled="False">Commit Edit</Button>
                <Button x:Name="rollbackEditButton" Padding="10,0" Click="RollbackEdit_Click" IsEnabled="False">Rollback Edit</Button>
                <Separator />
                <Button Padding="10,0" Click="FullExtent_Click">Full Extent</Button>
                <TextBlock x:Name="editStateText"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="Editing: OFF | Feature count: 0" />
            </ToolBar>
        </ToolBarTray>

        <gk:GeoKernelViewerControl x:Name="viewerControl" Grid.Row="1" />
        
        <Border Grid.Row="2" Background="#F4F4F4" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="statusText"
                       VerticalAlignment="Center"
                       Margin="4,0"
                       Text="Ready" />
        </Border>
    </Grid>
</Window>
