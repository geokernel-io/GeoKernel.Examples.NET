<Window x:Class="GeoKernel.UtmZones.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UtmZones" Width="1000" Height="720" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen" Icon="Images/GeoKernelAppIcon.ico" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="70"/>
                <ColumnDefinition Width="130"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="Hemisphere:"/>
            <ComboBox x:Name="hemisphereComboBox" Grid.Column="1" Margin="0,0,10,0" SelectedIndex="0" KeyDown="Input_KeyDown">
                <ComboBoxItem Content="Northern hemisphere"/><ComboBoxItem Content="Southern hemisphere"/>
            </ComboBox>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0" Text="UTM zone:"/>
            <TextBox x:Name="zoneTextBox" Grid.Column="3" Margin="0,0,8,0" Text="35" VerticalContentAlignment="Center" KeyDown="Input_KeyDown" PreviewTextInput="ZoneTextBox_PreviewTextInput"/>
            <Button Grid.Column="4" Margin="0,0,8,0" Content="Show UTM CRS" Click="FindButton_Click"/>
            <TextBox x:Name="summaryTextBox" Grid.Column="5" IsReadOnly="True" VerticalContentAlignment="Center"/>
        </Grid>
        <TextBox x:Name="detailsTextBox" Grid.Row="1" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        <StatusBar Grid.Row="2"><TextBlock x:Name="statusText" Text="Select a WGS 84 UTM zone."/></StatusBar>
    </Grid>
</Window>
