<Window x:Class="GeoKernel.BufferAnimated.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="BufferAnimated"
        Width="980"
        Height="680"
        MinWidth="720"
        MinHeight="480"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button x:Name="playPauseButton"
                    Content="Pause"
                    Click="PlayPause_Click" />
            <Button Content="Full Extent"
                    Click="FullExtent_Click" />
            <Separator />
            <TextBlock Text="Interval:"
                       VerticalAlignment="Center"
                       Margin="6,0,4,0" />
            <Slider x:Name="intervalSlider"
                    Width="160"
                    Minimum="20"
                    Maximum="200"
                    Value="60"
                    ValueChanged="IntervalSlider_ValueChanged" />
            <Separator />
            <TextBlock Text="Distance:"
                       VerticalAlignment="Center"
                       Margin="6,0,4,0" />
            <TextBlock x:Name="distanceText"
                       Width="80"
                       VerticalAlignment="Center" />
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="statusText" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <gk:GeoKernelViewerControl x:Name="viewerControl"
                                       Grid.Column="0" />

            <TextBox x:Name="detailsTextBox"
                     Grid.Column="1"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>
    </DockPanel>
</Window>
