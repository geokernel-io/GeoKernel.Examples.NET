<Window x:Class="GeoKernel.SnappingComparison.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="SnappingComparison" Width="1200" Height="800" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#F4F6F5"
        Icon="Images/GeoKernelAppIcon.ico" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="30"/><Setter Property="Padding" Value="8,2"/>
            <Setter Property="Focusable" Value="False"/><Setter Property="Background" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
        </Style>
        <Style x:Key="ToolbarToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="30"/><Setter Property="Padding" Value="8,2"/>
            <Setter Property="Focusable" Value="False"/><Setter Property="Background" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#D9ECFF"/><Setter Property="BorderBrush" Value="#0078D7"/></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#F1F1F1">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButton}" Click="FullExtent_Click" Content="Full Extent"/>
                <Border Width="1" Height="24" Margin="4" Background="#C8C8C8"/>
                <ToggleButton x:Name="addLineButton" Style="{StaticResource ToolbarToggle}" IsChecked="True" Click="AddLine_Click" Content="Add Polyline"/>
                <ToggleButton x:Name="panButton" Style="{StaticResource ToolbarToggle}" Click="Pan_Click" Content="Pan"/>
                <Border Width="1" Height="24" Margin="4" Background="#C8C8C8"/>
                <ToggleButton x:Name="snappingButton" Style="{StaticResource ToolbarToggle}" IsChecked="True" Click="Snapping_Click" Content="Snapping ON"/>
                <TextBlock Margin="8,0,4,0" VerticalAlignment="Center" Text="Tolerance px"/>
                <Slider x:Name="toleranceSlider" Width="120" Minimum="1" Maximum="64" Value="14" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ToleranceSlider_ValueChanged"/>
                <TextBlock x:Name="toleranceText" Width="28" VerticalAlignment="Center" Text="14"/>
                <Button Style="{StaticResource ToolbarButton}" Click="ResetGuide_Click" Content="Reset Guide"/>
                <TextBlock x:Name="lineCountText" Margin="14,0,0,0" VerticalAlignment="Center" Text="Drawn lines: 0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
            <gk:GeoKernelViewerControl x:Name="viewerControl"/>
            <TextBox x:Name="infoTextBox" Grid.Column="1" BorderThickness="1,0,0,0" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="White"/>
        </Grid>
        <StatusBar Grid.Row="2"><TextBlock x:Name="statusText" Text="Ready"/></StatusBar>
    </Grid>
</Window>
