<Window x:Class="GeoKernel.LabelCollisionOff.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="LabelCollisionOff" Width="1300" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="Images/GeoKernelAppIcon.ico" Loaded="Window_Loaded">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" Height="24">
            <TextBlock x:Name="statusText" Text="Preparing world and city sample data..." />
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#EEEEEE">
                    <TextBlock Text="labelAllowOverlap = false" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                </Border>
                <gk:GeoKernelViewerControl x:Name="collisionOnViewer" Grid.Row="1" />
            </Grid>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#B8B8B8" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#EEEEEE">
                    <TextBlock Text="labelAllowOverlap = true" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                </Border>
                <gk:GeoKernelViewerControl x:Name="collisionOffViewer" Grid.Row="1" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
