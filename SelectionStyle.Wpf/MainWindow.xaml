<Window x:Class="GeoKernel.SelectionStyle.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="SelectionStyle"
        Width="1100"
        Height="720"
        MinWidth="720"
        MinHeight="480"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ColorButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BorderBrush" Value="#7F8C8D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Background="#EFEFEF"
                Padding="10">
            <StackPanel>
                <TextBlock Text="Selected Line Color" Margin="0,0,0,8" />
                <Button x:Name="selectedLineColorButton"
                        Style="{StaticResource ColorButtonStyle}"
                        Click="SelectedLineColorButton_Click" />

                <TextBlock Text="Selected Line Width" Margin="0,0,0,8" />
                <TextBox x:Name="selectedLineWidthTextBox"
                         Style="{StaticResource InputStyle}"
                         Text="4.0"
                         TextChanged="SelectedLineWidthTextBox_TextChanged" />

                <Button x:Name="clearSelectionButton"
                        Height="26"
                        Margin="0,0,0,10"
                        Content="Clear Selection"
                        Click="ClearSelectionButton_Click" />

                <Button x:Name="resetStyleButton"
                        Height="26"
                        Margin="0,0,0,14"
                        Content="Reset Style"
                        Click="ResetStyleButton_Click" />

                <TextBlock TextWrapping="Wrap"
                           Text="Click any polygon, line, or point on the map. Selection rendering uses SelectedLineColor and SelectedLineWidth." />
            </StackPanel>
        </Border>

        <gk:GeoKernelViewerControl x:Name="viewerControl"
                                   Grid.Row="0"
                                   Grid.Column="1" />

        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                Background="#F4F4F4"
                BorderBrush="#D0D0D0"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="statusText"
                       VerticalAlignment="Center"
                       Margin="4,0"
                       Text="Ready" />
        </Border>
    </Grid>
</Window>
