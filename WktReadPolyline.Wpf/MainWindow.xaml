<Window x:Class="GeoKernel.WktReadPolyline.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="WktReadPolyline"
        Width="1100"
        Height="720"
        MinWidth="800"
        MinHeight="520"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <DockPanel>
        <Grid DockPanel.Dock="Top"
              Margin="6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="WKT:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBox x:Name="wktTextBox"
                     Grid.Column="1"
                     Text="LINESTRING(-122.4194 37.7749, -121.8863 37.3382, -121.4944 38.5816, -120.7401 37.6391)"
                     VerticalContentAlignment="Center"
                     KeyDown="WktTextBox_KeyDown" />
            <Button Grid.Column="2"
                    Content="Read LineString"
                    Margin="8,0,0,0"
                    Padding="10,2"
                    Click="ReadLineString_Click" />
            <Button Grid.Column="3"
                    Content="Reset"
                    Margin="6,0,0,0"
                    Padding="10,2"
                    Click="Reset_Click" />
        </Grid>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="statusText" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <gk:GeoKernelViewerControl x:Name="viewerControl"
                                       Grid.Column="0" />

            <TextBox x:Name="detailsTextBox"
                     Grid.Column="1"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>
    </DockPanel>
</Window>
