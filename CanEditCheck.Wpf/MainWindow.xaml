<Window x:Class="GeoKernel.CanEditCheck.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="CanEditCheck"
        Width="1200"
        Height="800"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <ToolBarTray Grid.Row="0" Background="#EFEFEF">
            <ToolBar Height="32" Background="#EFEFEF" BorderThickness="0" Padding="0">
                <Button x:Name="beginEditButton" Padding="10,0" Click="BeginEdit_Click">Begin Edit</Button>
                <Button x:Name="commitEditButton" Padding="10,0" Click="CommitEdit_Click" IsEnabled="False">Commit Edit</Button>
                <Button x:Name="rollbackEditButton" Padding="10,0" Click="RollbackEdit_Click" IsEnabled="False">Rollback Edit</Button>
                <Separator />
                <ToggleButton x:Name="selectButton" Padding="10,0" IsChecked="True" Click="Select_Click">Select</ToggleButton>
                <Button x:Name="clearSelectionButton" Padding="10,0" Click="ClearSelection_Click" IsEnabled="False">Clear Selection</Button>
                <Separator />
                <Button Padding="10,0" Click="Reset_Click">Reset Points</Button>
                <Button Padding="10,0" Click="FullExtent_Click">Full Extent</Button>
                <TextBlock x:Name="stateText" Margin="12,0,0,0" VerticalAlignment="Center" Text="Editing: OFF | Selected: 0" />
            </ToolBar>
        </ToolBarTray>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <gk:GeoKernelViewerControl x:Name="viewerControl" Grid.Column="0" />

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="140" />
                    <RowDefinition Height="150" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ListView x:Name="checkListView" Grid.Row="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="API" Width="170" DisplayMemberBinding="{Binding Api}" />
                            <GridViewColumn Header="Result" Width="70" DisplayMemberBinding="{Binding Result}" />
                            <GridViewColumn Header="Why" Width="250" DisplayMemberBinding="{Binding Why}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBox x:Name="selectionTextBox"
                         Grid.Row="1"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Background="White"
                         BorderThickness="0,1,0,1" />

                <ListView x:Name="featureListView" Grid.Row="2">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" Width="50" DisplayMemberBinding="{Binding ShapeId}" />
                            <GridViewColumn Header="Name" Width="120" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Group" Width="90" DisplayMemberBinding="{Binding Group}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#F4F4F4" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="statusText" VerticalAlignment="Center" Margin="4,0" Text="Ready" />
        </Border>
    </Grid>
</Window>
