<Window x:Class="GeoKernel.LabelOffset.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="LabelOffset"
        Width="1200"
        Height="800"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#EFEFEF" Padding="8">
                <StackPanel>
                    <TextBlock Text="Label offset" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <TextBlock Text="Offset X" Margin="0,0,0,6" />
                    <Slider x:Name="offsetXSlider" Minimum="-80" Maximum="80" Value="0" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="OffsetControl_Changed" />
                    <TextBlock x:Name="offsetXText" Text="0.0" Margin="0,4,0,12" />

                    <TextBlock Text="Offset Y" Margin="0,0,0,6" />
                    <Slider x:Name="offsetYSlider" Minimum="-80" Maximum="80" Value="0" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="OffsetControl_Changed" />
                    <TextBlock x:Name="offsetYText" Text="0.0" Margin="0,4,0,12" />

                    <Button Height="26" Content="Reset Offset" Click="ResetOffset_Click" />
                </StackPanel>
            </Border>

            <gk:GeoKernelViewerControl x:Name="viewerControl" Grid.Column="1" />
        </Grid>

        <Border Grid.Row="1" Background="#F4F4F4" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="statusText" VerticalAlignment="Center" Margin="4,0" Text="Ready" />
        </Border>
    </Grid>
</Window>
