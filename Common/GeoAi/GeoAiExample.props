<Project>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>..\Images\GeoKernelAppIcon.ico</ApplicationIcon>
    <GeoKernelSdkVersion Condition="'$(GeoKernelSdkVersion)' == ''">1.5.39</GeoKernelSdkVersion>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\Images\GeoKernelAppIcon.ico" LogicalName="GeoKernel.Examples.AppIcon.ico" />
    <Compile Include="$(MSBuildThisFileDirectory)*.cs" Link="Common\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
