<Window x:Class="GeoKernel.GlobeRasterServices.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="GeoKernel — Sagrada Ortho &amp; DEM" Width="1200" Height="800"
        MinWidth="720" MinHeight="480" WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>
        <gk:GeoKernelGlobeControl x:Name="GlobeView" Grid.Row="0" GlobeReady="GlobeReady" />
        <Border Grid.Row="1" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <TextBlock x:Name="Status" Text="Preparing globe…" Margin="6,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Border>
    </Grid>
</Window>
