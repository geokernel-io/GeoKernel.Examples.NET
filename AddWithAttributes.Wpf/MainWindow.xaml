<Window x:Class="GeoKernel.AddWithAttributes.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="AddWithAttributes"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Background="#F4F6F5"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#F1F1F1" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ToolbarToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#F1F1F1" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="160" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F1F1F1">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="AddPoint_Click" Content="Add Point With Attributes" />
                <ToggleButton x:Name="infoButton" Style="{StaticResource ToolbarToggleStyle}" Click="Info_Click" Content="Info" />
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="ClearPoints_Click" Content="Clear Points" />
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="FullExtent_Click" Content="Full Extent" />
                <Border Width="1" Height="24" Margin="4,4" Background="#C8C8C8" />
                <TextBlock x:Name="featureCountText"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Feature count: 0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <gk:GeoKernelViewerControl x:Name="viewerControl"
                                       Grid.Column="0"
                                       MapMouseUp="ViewerControl_MapMouseUp" />

            <TextBox x:Name="infoTextBox"
                     Grid.Column="1"
                     Margin="4,0,0,0"
                     Padding="6"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
        </Grid>

        <DataGrid x:Name="attributesGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding ShapeId}" Width="70" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="*" />
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="3">
            <TextBlock x:Name="statusText" Text="Ready" />
        </StatusBar>
    </Grid>
</Window>
