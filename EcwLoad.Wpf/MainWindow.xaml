<Window x:Class="GeoKernel.EcwLoad.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="EcwLoad"
        Width="1180"
        Height="760"
        MinWidth="720"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="ToolbarIconStyle" TargetType="Image">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F1F1F1" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Zoom In" Click="ZoomIn_Click">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/ZoomIn.png" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Zoom Out" Click="ZoomOut_Click">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/ZoomOut.png" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Full Extent" Click="FullExtent_Click">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/FullExtent.png" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Zoom Rectangle" Click="ZoomRectangle_Click">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/RectangularZoom.png" />
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Pan" Click="Pan_Click">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Images/Pan.png" />
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>
            <gk:GeoKernelViewerControl x:Name="viewerControl" Grid.Column="0" />
            <TextBox x:Name="detailsTextBox" Grid.Column="1" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="7" />
        </Grid>

        <StatusBar Grid.Row="2">
            <TextBlock x:Name="statusText" Text="EcwLoad ready." />
        </StatusBar>
    </Grid>
</Window>
