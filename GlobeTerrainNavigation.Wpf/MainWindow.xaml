<Window x:Class="GeoKernel.GlobeTerrainNavigation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="GeoKernel — Terrain &amp; Navigation" Width="1200" Height="800"
        MinWidth="640" MinHeight="480" WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>
        <ToolBar x:Name="Toolbar" IsEnabled="False" ToolBarTray.IsLocked="True">
            <ToggleButton x:Name="Atmosphere" Content="Atmosphere" Click="ApplyOptions" />
            <ToggleButton x:Name="Esri" Content="Esri Satellite" Click="ApplyOptions"
                          ToolTip="Esri World Imagery; internet required" />
            <ToggleButton x:Name="Dem" Content="DEM" Click="ApplyOptions"
                          ToolTip="Esri Terrain3D elevation, 1x; internet required" />
            <ToggleButton x:Name="Sunlight" Content="Sunlight" Click="ApplyOptions" />
        </ToolBar>
        <ToolBar x:Name="Navigation" Grid.Row="1" IsEnabled="False" ToolBarTray.IsLocked="True">
            <Button Content="Zoom in" Tag="{x:Static gk:GlobeNavigation.ZoomIn}" Click="Navigate" />
            <Button Content="Zoom out" Tag="{x:Static gk:GlobeNavigation.ZoomOut}" Click="Navigate" />
            <Button Content="Rotate left" Tag="{x:Static gk:GlobeNavigation.RotateLeft}" Click="Navigate" />
            <Button Content="Rotate right" Tag="{x:Static gk:GlobeNavigation.RotateRight}" Click="Navigate" />
            <Button Content="Tilt up" Tag="{x:Static gk:GlobeNavigation.TiltUp}" Click="Navigate" />
            <Button Content="Tilt down" Tag="{x:Static gk:GlobeNavigation.TiltDown}" Click="Navigate" />
            <Button Content="Top view" Tag="{x:Static gk:GlobeNavigation.Top}" Click="Navigate" />
            <Button Content="North" Tag="{x:Static gk:GlobeNavigation.North}" Click="Navigate" />
            <Button Content="Overview" Tag="{x:Static gk:GlobeNavigation.Home}" Click="Navigate" />
        </ToolBar>
        <gk:GeoKernelGlobeControl x:Name="GlobeView" Grid.Row="2" GlobeReady="GlobeReady" />
        <Border Grid.Row="3" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <TextBlock x:Name="Status" Text="Preparing globe…" Margin="6,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Border>
    </Grid>
</Window>
