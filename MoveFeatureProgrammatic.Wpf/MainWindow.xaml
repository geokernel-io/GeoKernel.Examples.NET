<Window x:Class="GeoKernel.MoveFeatureProgrammatic.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="MoveFeatureProgrammatic"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="Images/GeoKernelAppIcon.ico"
        Background="#F4F6F5"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#F1F1F1" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ToolbarToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F1F1F1">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="selectButton"
                              Style="{StaticResource ToolbarToggleStyle}"
                              IsChecked="True"
                              Click="Select_Click"
                              Content="Select" />
                <TextBlock Margin="10,0,4,0" VerticalAlignment="Center" Text="Delta:" />
                <TextBox x:Name="deltaTextBox"
                         Width="56"
                         Height="24"
                         VerticalContentAlignment="Center"
                         Text="3.00" />
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="MoveWest_Click" Content="West" />
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="MoveEast_Click" Content="East" />
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="MoveNorth_Click" Content="North" />
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="MoveSouth_Click" Content="South" />
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="ResetPoints_Click" Content="Reset Points" />
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="FullExtent_Click" Content="Full Extent" />
                <Border Width="1" Height="24" Margin="4,4" Background="#C8C8C8" />
                <TextBlock x:Name="countText"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Feature count: 0 | Selected: 0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="featureListView"
                      Grid.Column="0"
                      SelectionChanged="FeatureListView_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" Width="48" DisplayMemberBinding="{Binding ShapeId}" />
                        <GridViewColumn Header="Name" Width="90" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Group" Width="70" DisplayMemberBinding="{Binding Group}" />
                        <GridViewColumn Header="Current X, Y" Width="130" DisplayMemberBinding="{Binding LocationText}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <gk:GeoKernelViewerControl x:Name="viewerControl"
                                       Grid.Column="1" />
        </Grid>

        <StatusBar Grid.Row="2">
            <TextBlock x:Name="statusText" Text="Ready" />
        </StatusBar>
    </Grid>
</Window>
