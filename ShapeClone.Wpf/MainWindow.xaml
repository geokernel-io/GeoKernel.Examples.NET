<Window x:Class="GeoKernel.ShapeClone.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="ShapeClone" Width="1040" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Icon="Images/GeoKernelAppIcon.ico" Loaded="Window_Loaded">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top" Height="32">
            <Button Content="Full Extent" Click="FullExtent_Click"/>
            <Separator/><TextBlock Text="Shape clone (.NET managed geometry)" VerticalAlignment="Center" Margin="6,0"/>
        </ToolBar>
        <StatusBar DockPanel.Dock="Bottom"><TextBlock x:Name="statusText"/></StatusBar>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
            <gk:GeoKernelViewerControl x:Name="viewerControl"/>
            <TextBox x:Name="detailsTextBox" Grid.Column="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </Grid>
    </DockPanel>
</Window>
