<Window x:Class="GeoKernel.XyzDiagnostics.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="XyzDiagnostics" Width="1200" Height="800" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen" Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <DockPanel Background="#F4F6F5">
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Band="0" BandIndex="0">
                <Button ToolTip="Zoom In" Click="ZoomIn_Click"><Image Source="Images/ZoomIn.png" Width="28" Height="28" /></Button>
                <Button ToolTip="Zoom Out" Click="ZoomOut_Click"><Image Source="Images/ZoomOut.png" Width="28" Height="28" /></Button>
                <Button ToolTip="Full Extent" Click="FullExtent_Click"><Image Source="Images/FullExtent.png" Width="28" Height="28" /></Button>
                <Separator />
                <ToggleButton x:Name="zoomRectButton" ToolTip="Zoom Rect" Click="ZoomRect_Click"><Image Source="Images/RectangularZoom.png" Width="28" Height="28" /></ToggleButton>
                <ToggleButton x:Name="panButton" IsChecked="True" ToolTip="Pan" Click="Pan_Click"><Image Source="Images/Pan.png" Width="28" Height="28" /></ToggleButton>
                <Separator />
                <Button Padding="8,3" Click="RefreshStats_Click">Refresh Stats</Button>
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom" Height="22"><TextBlock x:Name="statusText" Text="XyzDiagnostics ready." /></StatusBar>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="390" /></Grid.ColumnDefinitions>
            <gk:GeoKernelViewerControl x:Name="viewerControl" Grid.Column="0" />
            <GroupBox Grid.Column="1" Header="XYZ diagnostics">
                <TextBox x:Name="detailsTextBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
