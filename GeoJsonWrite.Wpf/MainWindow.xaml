<Window x:Class="GeoKernel.GeoJsonWrite.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gk="clr-namespace:GeoKernel.NET.Wpf.Controls;assembly=GeoKernel.NET.Wpf.Controls"
        Title="GeoJsonWrite"
        Width="1100"
        Height="720"
        Icon="Images/GeoKernelAppIcon.ico"
        Loaded="Window_Loaded">
    <DockPanel>
        <Grid DockPanel.Dock="Top"
              Margin="6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Clear"
                    Padding="12,2"
                    Click="Clear_Click" />
            <TextBlock Grid.Column="1"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Text="Click polygon vertices, then press Enter or double-click to finish. GeoJSON is written automatically." />
        </Grid>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="statusText" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>
            <gk:GeoKernelViewerControl x:Name="viewerControl"
                                       Grid.Column="0" />
            <TextBox x:Name="detailsTextBox"
                     Grid.Column="1"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="GisGeoJsonWriter::writePolygonString(shape)&#x0a;&#x0a;Draw a polygon on the map. The GeoJSON string will appear here." />
        </Grid>
    </DockPanel>
</Window>
